{
	"compilerOptions": {
		// Target modern JavaScript features
		"target": "ES2020",

		// Use ESNext module system for ESM support
		"module": "ESNext",

		// Resolve modules using Node.js resolution
		"moduleResolution": "node",

		// Include modern JavaScript libraries
		"lib": ["ES2020"],

		// Enable strict type-checking options
		"strict": true,
		"noImplicitReturns": true,
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noPropertyAccessFromIndexSignature": true,

		// Allow default imports for modules without default exports
		"allowSyntheticDefaultImports": true,

		// Enable JSON module imports
		"resolveJsonModule": true,

		// Skip emitting declaration files
		"declaration": false,

		// Improve debugging and readability
		"pretty": true,

		// Enforce consistent line endings
		"newLine": "lf",

		// Remove unused internal code
		"stripInternal": true,

		// Prevent emitting files if there are errors
		"noEmitOnError": true,

		// Use `define` semantics for class fields
		"useDefineForClassFields": true,

		// Ensure consistent file casing
		"forceConsistentCasingInFileNames": true,

		// Skip type checking of declaration files
		"skipLibCheck": true,

		// Specify type definitions folder
		"typeRoots": ["./node_modules/@types"]
	}
}
